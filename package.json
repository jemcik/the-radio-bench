{
  "name": "the-radio-bench",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "homepage": "https://radiobench.dev",
  "scripts": {
    "build": "tsc -b && vite build",
    "check:i18n": "node scripts/check-i18n.mjs",
    "check:i18n-usage": "node scripts/check-i18n-usage.mjs",
    "check:uk": "node .claude/skills/ua-translate/scripts/lint-ua-translation.mjs src/i18n/locales/uk/ui.json",
    "check:trans": "node scripts/check-trans-components.mjs",
    "check:i18n-void-tags": "node scripts/check-i18n-void-tags.mjs",
    "check:var-multichar-subscripts": "node scripts/check-var-multichar-subscripts.mjs",
    "check:unwrapped-math-var": "node scripts/check-unwrapped-math-var.mjs",
    "check:diagram-viewbox-fit": "node scripts/check-diagram-viewbox-fit.mjs",
    "check:quiz-trans": "node scripts/check-quiz-trans-components.mjs",
    "check:glossary-coverage": "node scripts/check-glossary-coverage.mjs",
    "check:glossary-overwrap": "node scripts/check-glossary-overwrap.mjs",
    "check:bare-subscripts": "node scripts/check-bare-subscript-renders.mjs",
    "check:tag-renders": "node scripts/check-tag-renders.mjs",
    "check:undefined-acronyms": "node scripts/check-undefined-acronyms.mjs",
    "check:acronym-parity": "node scripts/check-acronym-parity.mjs",
    "check:hardcoded-units": "node scripts/check-hardcoded-units.mjs",
    "check:hardcoded-jsx": "node scripts/check-hardcoded-jsx-text.mjs",
    "check:hardcoded-jsx-subscript": "node scripts/check-hardcoded-jsx-subscript.mjs",
    "check:circuit-conventions": "node scripts/check-circuit-conventions.mjs",
    "check:glossary-markup": "node scripts/check-glossary-markup.mjs",
    "check:glossary-completeness": "node scripts/check-glossary-completeness.mjs",
    "check:diagram-fontsize": "node scripts/check-diagram-fontsize.mjs",
    "check:svg-diagram-fontsize-units": "node scripts/check-svg-diagram-fontsize-units.mjs",
    "check:junction-placement": "node scripts/check-junction-placement.mjs",
    "check:designator-case": "node scripts/check-designator-case.mjs",
    "check:wire-pin-alignment": "node scripts/check-wire-pin-alignment.mjs",
    "check:quiz-balance": "node scripts/check-quiz-balance.mjs",
    "check:all": "npm run check:i18n && npm run check:i18n-usage && npm run check:uk && npm run check:trans && npm run check:i18n-void-tags && npm run check:var-multichar-subscripts && npm run check:unwrapped-math-var && npm run check:quiz-trans && npm run check:bare-subscripts && npm run check:tag-renders && npm run check:hardcoded-jsx && npm run check:hardcoded-jsx-subscript && npm run check:circuit-conventions && npm run check:hardcoded-units && npm run check:glossary-markup && npm run check:glossary-coverage && npm run check:glossary-overwrap && npm run check:glossary-completeness && npm run check:diagram-fontsize && npm run check:svg-diagram-fontsize-units && npm run check:junction-placement && npm run check:diagram-viewbox-fit && npm run check:wire-pin-alignment && npm run check:designator-case && npm run check:undefined-acronyms && npm run check:acronym-parity && npm run check:quiz-balance && npm run check:gitignore",
    "check:gitignore": "sh -c '! git ls-files | git check-ignore --no-index --stdin -q || (echo \"Tracked paths match .gitignore (remove with git rm --cached):\"; git ls-files | git check-ignore --no-index --stdin -v; exit 1)'",
    "dev": "vite",
    "extract:glossary": "node --experimental-strip-types scripts/extract-glossary.mjs",
    "knip": "knip",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@radix-ui/react-collapsible": "^1.1.2",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-scroll-area": "^1.2.1",
    "@radix-ui/react-separator": "^1.1.1",
    "@radix-ui/react-slider": "^1.3.6",
    "@radix-ui/react-slot": "^1.1.1",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@radix-ui/react-visually-hidden": "^1.1.1",
    "@visx/axis": "^3.12.0",
    "@visx/grid": "^3.12.0",
    "@visx/group": "^3.12.0",
    "@visx/scale": "^3.12.0",
    "@visx/shape": "^3.12.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "i18next": "^26.0.4",
    "i18next-browser-languagedetector": "^8.2.1",
    "katex": "^0.16.45",
    "lucide-react": "^0.460.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-i18next": "^17.0.2",
    "react-router-dom": "^6.27.0",
    "roughjs": "^4.6.6",
    "tailwind-merge": "^2.5.4"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^22.9.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^4.3.3",
    "@vitest/ui": "^2.1.9",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.13.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "globals": "^17.5.0",
    "jsdom": "^29.0.2",
    "knip": "^6.4.1",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.15",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.58.1",
    "vite": "^5.4.10",
    "vitest": "^2.1.9"
  }
}
